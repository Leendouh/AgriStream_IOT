@{
    ViewData["Title"] = "Upload drone image";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <h2>Upload drone image</h2>
        <p class="text-muted">The file lands in the <code>drone-images</code> blob container, which fires the
        blob-triggered Azure Function to record a processing audit entry in Table Storage.</p>
        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <input type="file" name="image" class="form-control" accept="image/*" required />
            </div>
            <button class="btn btn-success">Upload to Blob Storage</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>
